---
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const navItems = [
  ['How to Use', 'how-to-use'],
  ['Capabilities', 'capabilities'],
  ['Architecture', 'architecture'],
  ['Demo', 'demo'],
  ['Docs', 'docs'],
  ['Releases', 'releases'],
  ['Trust', 'security']
] as const;
const isActive = (slug: string) => currentPath === `${base}${slug}`.replace(/\/$/, '') || currentPath.startsWith(`${base}${slug}/`);
const socialImage = new URL(`${base}og-default.svg`, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070a0f" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.toString()} />
    <meta property="og:site_name" content="Vericore" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.toString()} />
    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Vericore',
      applicationCategory: 'DeveloperApplication',
      description,
      url: canonical.toString(),
      codeRepository: 'https://github.com/sonii-shivansh/Vericore',
      image: socialImage.toString()
    })} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="nav container" aria-label="Primary navigation">
        <a class="brand" href={base} aria-label="Vericore home"><span class="brand-mark" aria-hidden="true">V</span><span>Vericore</span></a>
        <div class="nav-links" aria-label="Site sections">
          {navItems.map(([label, slug]) => <a class:list={{ active: isActive(slug) }} href={`${base}${slug}/`} aria-current={isActive(slug) ? 'page' : undefined}>{label}</a>)}
          <a class="nav-github" href="https://github.com/sonii-shivansh/Vericore">GitHub ↗</a>
        </div>
        <details class="mobile-menu">
          <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
          <div class="mobile-menu-panel">
            <div class="mobile-menu-label">Explore Vericore</div>
            {navItems.map(([label, slug]) => <a class:list={{ active: isActive(slug) }} href={`${base}${slug}/`} aria-current={isActive(slug) ? 'page' : undefined}>{label}</a>)}
            <a class="mobile-github" href="https://github.com/sonii-shivansh/Vericore">View source on GitHub ↗</a>
          </div>
        </details>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer"><div class="container footer-inner"><span>Vericore — evidence-driven engineering intelligence.</span><div class="footer-links"><a href={`${base}how-to-use/`}>How to Use</a><a href={`${base}capabilities/`}>Capabilities</a><a href={`${base}docs/`}>Docs</a><a href={`${base}security/`}>Trust</a></div></div></footer>
  </body>
</html>
<style is:global>
:root{color-scheme:dark;--bg:#070a0f;--panel:#0d121a;--panel-2:#111823;--line:#1d2836;--text:#e8edf3;--muted:#8e9aaa;--accent:#73d5ff;--success:#6ee7b7;--max:1180px;--gutter:clamp(12px,3vw,40px);--section-gap:clamp(70px,8vw,120px)}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;overflow-x:hidden;scrollbar-gutter:stable}
body{margin:0;min-width:320px;overflow-x:hidden;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;line-height:1.6}
main{min-width:0;overflow-x:clip}
img,svg,video,canvas{display:block;max-width:100%;height:auto}
iframe{max-width:100%;border:0}
a{color:inherit}
button,input,textarea,select{font:inherit;max-width:100%}
button{touch-action:manipulation}
pre,code{font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace}
pre{max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain}
pre,code{overflow-wrap:normal}
h1,h2,h3,h4,p{overflow-wrap:anywhere}
table{max-width:100%;border-collapse:collapse}
.container{width:min(var(--max),calc(100% - (2 * var(--gutter))));margin-inline:auto}
.skip-link{position:fixed;left:12px;top:-80px;z-index:30;padding:10px 14px;background:var(--text);color:var(--bg);border-radius:8px}
.skip-link:focus{top:12px}
:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
.site-header{position:sticky;top:0;z-index:20;border-bottom:1px solid rgb(255 255 255 / 7%);background:rgb(7 10 15 / 90%);backdrop-filter:blur(14px);padding-top:env(safe-area-inset-top)}
.nav{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.brand{display:inline-flex;align-items:center;gap:10px;text-decoration:none;font-weight:700;letter-spacing:-.02em;min-width:0}
.brand>span:last-child{white-space:nowrap}
.brand-mark{display:grid;place-items:center;width:28px;height:28px;flex:0 0 28px;border:1px solid var(--accent);border-radius:7px;color:var(--accent);font-family:ui-monospace,SFMono-Regular,Menlo,monospace;background:rgba(115,213,255,.06)}
.nav-links,.footer-links{display:flex;gap:16px;color:var(--muted);font-size:.82rem}
.nav-links a,.footer-links a{text-decoration:none}
.nav-links a{padding:7px 0;position:relative}
.nav-links a:hover,.footer-links a:hover{color:var(--text)}
.nav-links a.active{color:var(--text)}
.nav-links a.active::after{content:'';position:absolute;left:0;right:0;bottom:0;height:2px;border-radius:2px;background:var(--accent)}
.nav-github{color:var(--text)!important;border:1px solid var(--line);padding:7px 11px!important;border-radius:7px;background:var(--panel)}
.mobile-menu{display:none;position:relative}
.mobile-menu summary{list-style:none;display:grid;place-content:center;gap:4px;width:44px;height:44px;cursor:pointer;border:1px solid var(--line);border-radius:8px;background:var(--panel)}
.mobile-menu summary::-webkit-details-marker{display:none}
.mobile-menu summary span{display:block;width:18px;height:2px;border-radius:2px;background:var(--text)}
.mobile-menu-panel{position:absolute;right:0;top:52px;width:min(320px,calc(100vw - 24px));max-height:min(78vh,620px);overflow:auto;padding:10px;border:1px solid var(--line);border-radius:10px;background:rgba(13,18,26,.98);box-shadow:0 18px 40px rgba(0,0,0,.28)}
.mobile-menu-label{padding:8px 12px 6px;color:var(--muted);font:.65rem ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.1em;text-transform:uppercase}
.mobile-menu-panel a{display:block;padding:12px;border-radius:7px;text-decoration:none;color:var(--muted);min-height:44px}
.mobile-menu-panel a:hover,.mobile-menu-panel a:focus-visible{color:var(--text);background:var(--panel-2)}
.mobile-menu-panel a.active{color:var(--text);background:var(--panel-2);box-shadow:inset 2px 0 var(--accent)}
.mobile-menu-panel .mobile-github{margin-top:6px;border-top:1px solid var(--line);border-radius:0;padding-top:16px;color:var(--text);font-weight:650}
.site-footer{border-top:1px solid var(--line);margin-top:var(--section-gap)}
.footer-inner{min-height:90px;display:flex;align-items:center;justify-content:space-between;gap:20px;color:var(--muted);font-size:.82rem;padding-block:20px}
.footer-links{flex-wrap:wrap;justify-content:flex-end}
@media(max-width:1100px){.nav-links{gap:12px;font-size:.78rem}}
@media(max-width:900px){.nav-links{display:none}.mobile-menu{display:block}}
@media(max-width:640px){.nav{min-height:60px}.footer-inner{flex-direction:column;align-items:flex-start;justify-content:center;padding-block:24px}.footer-links{justify-content:flex-start;gap:10px 14px}}
@media(max-width:430px){.mobile-menu-panel{width:calc(100vw - 24px)}.brand{gap:8px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto}}
</style>
