---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductLoop from '../components/ProductLoop.astro';
const base = import.meta.env.BASE_URL;

const capabilities = [
  ['Repository Intelligence', 'Java/Kotlin discovery, parsing, configurable exclusions, parallel analysis, caching, and self-contained HTML reporting.', 'how-to-use/'],
  ['Dependency & Graph Intelligence', 'Dependency graphs, wildcard imports, cycles, connected components, PageRank knowledge hotspots, and learning paths.', 'capabilities/'],
  ['Git & Evolution', 'Authorship, churn, modification time, recent changes, time-based commit sampling, and source-history hotspots.', 'capabilities/'],
  ['Change & PR Intelligence', 'Dependency-aware impact, blast-radius signals, change-size/risk signals, architecture findings, tests, and machine-readable artifacts.', 'capabilities/'],
  ['Architecture Governance', 'Architecture findings, drift against an explicit baseline, deterministic contracts, severity/finding/cycle limits, and decision records.', 'architecture/'],
  ['Engineering Context & Reality', 'Versioned snapshots, repository fingerprints, Git HEAD binding, context diffs, and deterministic Reality identity.', 'architecture/'],
  ['Grounded Repository Q&A', 'Intent-aware retrieval, bounded evidence, deterministic ranking, citations, and explicit insufficient-evidence handling.', 'capabilities/'],
  ['Engineering Planner', 'Read-only, evidence-backed implementation plans with affected components, risks, steps, verification criteria, and uncertainty.', 'how-to-use/'],
  ['Agent Change Contract', 'A persisted repository-bound change boundary with planned paths, evidence, verification, architecture expectations, and SHA-256 fingerprint.', 'architecture/'],
  ['Prepare → Change → Verify', 'Prepare before implementation and verify the original persisted contract after the change; tampering and stale state are detectable.', 'demo/'],
  ['CLI · REST · MCP', 'The same intelligence is available through the CLI, local Ktor REST API, and local MCP stdio integration.', 'how-to-use/'],
  ['Optional AI', 'Gemini/Anthropic assistance can reason over bounded repository-derived context; AI is disabled unless explicitly configured.', 'security/']
];
---

<BaseLayout title="VeriCore — Verify AI Coding Agent Changes" description="VeriCore is an open-source verification layer for AI coding agents. Prepare a change contract before edits, then check repository scope and evidence after the change. Built for Java and Kotlin workflows.">
  <section class="hero container">
    <div class="eyebrow"><span class="pulse"></span> Open source · local-first · AI coding-agent verification</div>
    <h1>AI changes code.<br /><span>Vericore verifies it.</span></h1>
    <p class="hero-copy">Vericore creates a repository-bound change contract before an AI coding agent edits code, then verifies the actual repository state against that original boundary.</p>
    <div class="actions">
      <a class="button primary" href="https://github.com/sonii-shivansh/Vericore" target="_blank" rel="noreferrer noopener">View on GitHub ↗</a>
      <a class="button secondary" href={`${base}demo/`}>See the proof</a>
      <a class="button tertiary" href={`${base}how-to-use/#prepare`}>Prepare a change safely</a>
    </div>

    <div class="terminal" aria-label="Example Vericore workflow output">
      <div class="terminal-bar"><span></span><span></span><span></span><strong>vericore 0.8.2</strong></div>
      <pre><code><span class="accent">PREPARE</span>
  change: add payment validation
  contract: agent-change-contract.json
  planned path: PaymentService.kt

<span class="accent">AGENT CHANGES CODE</span>
  PaymentService.kt              ✓
  PaymentValidator.kt            ✓
  PaymentDatabase.kt             ← unexpected

<span class="accent">VERIFY</span>
  scope check                    ✗ FAIL
  unexpected mutation            1 file

<span class="ok">The original contract stays authoritative.</span></code></pre>
    </div>
  </section>

  <section id="what-vericore-verifies" class="section container explainer">
    <div class="section-heading">
      <span class="kicker">WHAT IT VERIFIES</span>
      <h2>Verify AI coding-agent changes against the plan—not a moving target.</h2>
      <p>VeriCore is an open-source verification layer for AI-assisted software development. Before an agent edits a repository, VeriCore records a persisted Agent Change Contract that describes the intended change boundary. After the agent finishes, VeriCore checks the resulting repository against that original contract and the evidence available to it.</p>
    </div>
    <div class="explainer-grid">
      <article>
        <span class="meta">01 / Scope</span>
        <h3>Did the change stay within the boundary?</h3>
        <p>Check changed paths against the planned scope and surface unexpected repository mutations instead of silently treating them as part of the plan.</p>
      </article>
      <article>
        <span class="meta">02 / Repository state</span>
        <h3>Is the evidence tied to the intended repository state?</h3>
        <p>VeriCore uses repository identity, state fingerprints, and contract integrity checks to help detect stale or altered verification context.</p>
      </article>
      <article>
        <span class="meta">03 / Evidence</span>
        <h3>What was actually verified?</h3>
        <p>Verification results distinguish passing and failing checks from inconclusive or unevaluated criteria. The result is designed to be inspectable, not a vague “AI says it looks good.”</p>
      </article>
    </div>
  </section>

  <section id="how-it-works" class="section container explainer">
    <div class="section-heading">
      <span class="kicker">HOW IT WORKS</span>
      <h2>Prepare → Change → Verify</h2>
      <p>The contract is created before implementation and remains the reference point after the code changes.</p>
    </div>
    <ol class="workflow-list">
      <li><span>1</span><div><h3>Prepare the change</h3><p>Analyze the repository and save a contract describing the expected scope and verification criteria.</p></div></li>
      <li><span>2</span><div><h3>Let your coding agent work</h3><p>Use your normal AI coding workflow. VeriCore is a verification layer; it does not need to take over the agent or autonomously rewrite your source files.</p></div></li>
      <li><span>3</span><div><h3>Verify against the original contract</h3><p>Evaluate the changed repository against the saved boundary and available evidence, then inspect the verification result and receipt.</p></div></li>
    </ol>
    <p class="scope-note"><strong>Important:</strong> VeriCore does not claim to prove that code is bug-free or semantically correct. It checks declared constraints against the evidence its current evaluators can assess; unsupported criteria may remain inconclusive or unevaluated.</p>
  </section>

  <section id="who-should-use-vericore" class="section container explainer">
    <div class="section-heading">
      <span class="kicker">WHO IT IS FOR</span>
      <h2>For teams that need evidence after AI writes code.</h2>
      <p>VeriCore is especially relevant when AI coding agents are changing real repositories and developers need a clearer record of what was allowed, what changed, and what checks actually passed.</p>
    </div>
    <div class="audience-grid">
      <article><h3>Developers using AI coding agents</h3><p>Catch out-of-scope file changes and review whether an agent's work matches the intended change boundary.</p></article>
      <article><h3>Maintainers and engineering teams</h3><p>Add a repeatable, evidence-first check to code review and change workflows, particularly in Java and Kotlin repositories.</p></article>
      <article><h3>Agent and tooling builders</h3><p>Explore CLI, local MCP, REST, and GitHub Actions integration points for repository-aware verification workflows.</p></article>
    </div>
    <div class="explainer-links">
      <a class="button primary" href="https://github.com/sonii-shivansh/Vericore" target="_blank" rel="noreferrer noopener">Explore the open-source project ↗</a>
      <a class="button secondary" href={`${base}how-to-use/#prepare`}>Read the usage guide</a>
      <a class="button secondary" href={`${base}demo/`}>See an example</a>
    </div>
  </section>

  <section class="section container"><ProductLoop /></section>

  <section id="capabilities" class="section container">
    <div class="section-heading">
      <span class="kicker">01 / WHAT SHIPS</span>
      <h2>More than code analysis.</h2>
      <p>Vericore connects deterministic repository evidence to engineering decisions, architecture checks, impact analysis, and—most importantly—the verification boundary around AI-assisted changes.</p>
    </div>
    <div class="capability-grid">
      {capabilities.map(([title, description, href]) => (
        <a class="capability-card" href={`${base}${href}`}>
          <span>{title}</span>
          <p>{description}</p>
        </a>
      ))}
    </div>
  </section>

  <section id="architecture" class="section container">
    <div class="section-heading">
      <span class="kicker">02 / TRUST MODEL</span>
      <h2>Deterministic evidence first. Reasoning second.</h2>
      <p>Repository facts, Git history, and architecture signal are treated as the source of truth. AI is optional and bounded, never the authority that decides what is true.</p>
    </div>
    <div class="architecture-grid">
      <article>
        <span class="meta">Repository</span>
        <h3>Source, history, and state</h3>
        <p>Vericore captures the repository as it exists, including structure, dependency relationships, churn, and Git context.</p>
      </article>
      <article>
        <span class="meta">Analysis</span>
        <h3>Deterministic facts</h3>
        <p>It builds architecture findings, impact signals, hotspots, evolution clues, and evidence-backed summaries.</p>
      </article>
      <article>
        <span class="meta">Safety</span>
        <h3>Prepare and verify</h3>
        <p>Before code changes, a persisted contract captures the expected boundary. After changes, it verifies the original state against the updated repository.</p>
      </article>
    </div>
  </section>

  <section id="proof" class="section container proof">
    <div class="section-heading">
      <span class="kicker">03 / PROOF</span>
      <h2>From repository facts to a bounded engineering change.</h2>
      <p>Follow the loop from repository structure to change impact, evidence, plan, safety boundary, and final verification.</p>
    </div>
    <div class="proof-grid">
      <article>
        <span class="meta">01</span>
        <h3>Repository map</h3>
        <p>Map the source graph, dependency edges, and impacted modules before drawing conclusions.</p>
      </article>
      <article>
        <span class="meta">02</span>
        <h3>Impact</h3>
        <p>See the blast radius and the components most likely to be affected by a change.</p>
      </article>
      <article>
        <span class="meta">03</span>
        <h3>Evidence</h3>
        <p>Ground reasoning in citations, architecture links, and repository-derived facts rather than assumptions.</p>
      </article>
      <article>
        <span class="meta">04</span>
        <h3>Verification</h3>
        <p>Confirm the code still matches the prepared contract, not just a regenerated plan.</p>
      </article>
    </div>
  </section>

  <section class="section container launch">
    <div class="section-heading">
      <span class="kicker">04 / LOCAL-FIRST</span>
      <h2>Run it where your code already lives.</h2>
      <p>Released archives bundle the Java runtime and local tooling needed for repository intelligence, architecture checks, safety contracts, and verification workflows.</p>
    </div>
    <div class="launch-grid">
      <article>
        <h3>Local analysis</h3>
        <p>Keep the source of truth on disk, local to the repository, with deterministic artifacts and explicit boundaries.</p>
      </article>
      <article>
        <h3>Trusted by default</h3>
        <p>Vericore is designed around explicit repository validation, not silent reasoning or platform-side assumptions.</p>
      </article>
      <article>
        <h3>Ready for engineering teams</h3>
        <p>Use it for architecture review, dependency understanding, risk assessment, Q&A, and safe change planning.</p>
      </article>
    </div>
  </section>

  <section class="cta container">
    <div>
      <span class="kicker">OPEN SOURCE</span>
      <h2>Inspect the implementation.</h2>
      <p>Read the implementation, contracts, architecture docs, design notes, and verification workflows in the canonical Vericore repository.</p>
    </div>
    <div class="cta-actions">
      <a class="button primary" href="https://github.com/sonii-shivansh/Vericore" target="_blank" rel="noreferrer noopener">Open source repo ↗</a>
      <a class="button secondary" href={`${base}docs/`}>Browse docs</a>
    </div>
  </section>
</BaseLayout>

<style>
.hero{padding:112px 0 40px;position:relative}.hero::before{content:'';position:absolute;inset:0 -30vw auto;height:520px;z-index:-1;background:radial-gradient(circle at 50% 30%,rgb(115 213 255 / 10%),transparent 45%)}.eyebrow{display:inline-flex;align-items:center;gap:10px;color:var(--accent);font:600 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;text-transform:uppercase}.pulse{display:inline-block;width:10px;height:10px;border-radius:50%;background:var(--success);box-shadow:0 0 0 0 rgba(110,231,183,.4);animation:pulse 2s infinite}.hero h1{margin:20px 0 18px;font-size:clamp(4rem,8vw,7rem);line-height:.9;letter-spacing:-.07em}.hero h1 span{color:#dfeaf5}.hero-copy{max-width:720px;color:var(--muted);font-size:1.08rem;line-height:1.7}.actions{display:flex;flex-wrap:wrap;gap:14px;margin-top:26px}.button{display:inline-flex;align-items:center;justify-content:center;padding:12px 18px;border-radius:10px;border:1px solid var(--line);font-weight:700;text-decoration:none;transition:transform .2s ease,border-color .2s ease}.button:hover{transform:translateY(-1px)}.button.primary{background:var(--accent);color:#071018;border-color:transparent}.button.secondary{background:transparent;color:var(--text)}.button.tertiary{background:rgba(255,255,255,.02);color:var(--text)}
.explainer-grid,.audience-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.explainer-grid article,.audience-grid article{padding:22px;border:1px solid var(--line);border-radius:14px;background:rgba(17,24,35,.75)}.explainer-grid h3,.audience-grid h3{margin:12px 0 8px;font-size:1.15rem}.explainer-grid p,.audience-grid p{margin:0;color:var(--muted);line-height:1.7}.workflow-list{display:grid;gap:14px;list-style:none;padding:0;margin:0;max-width:900px}.workflow-list li{display:flex;gap:16px;align-items:flex-start;padding:18px;border:1px solid var(--line);border-radius:12px;background:rgba(17,24,35,.65)}.workflow-list li>span{display:grid;place-items:center;flex:0 0 34px;height:34px;border-radius:50%;background:var(--accent);color:#071018;font-weight:800}.workflow-list h3{margin:2px 0 6px}.workflow-list p{margin:0;color:var(--muted);line-height:1.7}.scope-note{max-width:900px;margin-top:18px;padding:16px 18px;border-left:3px solid var(--accent);background:rgba(115,213,255,.06);color:var(--muted);line-height:1.7}.scope-note strong{color:var(--text)}.explainer-links{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.terminal{margin-top:36px;width:min(100%,720px);border:1px solid var(--line);border-radius:14px;background:rgba(10,16,22,.9);box-shadow:0 24px 60px rgba(0,0,0,.2);overflow:hidden}.terminal-bar{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--line);background:rgba(255,255,255,.02);color:var(--muted);font:.72rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}.terminal-bar span{display:inline-block;width:10px;height:10px;border-radius:50%;background:rgba(255,255,255,.25)}.terminal-bar strong{margin-left:10px;color:var(--text)}.terminal pre{margin:0;padding:18px 20px;color:#dfeaf5;font-size:.88rem;line-height:1.8}.ok{color:var(--success)}.accent{color:var(--accent)}
.section{padding-top:var(--section-gap)}.section-heading{max-width:820px;margin-bottom:28px}.section-heading .kicker,.meta{color:var(--accent);font:600 .72rem/1.2 ui-monospace,SFMono-Regular,Menlo,monospace;letter-spacing:.12em;text-transform:uppercase}.section-heading h2{margin:16px 0 12px;font-size:clamp(2.2rem,5vw,3.5rem);letter-spacing:-.05em;line-height:1.06}.section-heading p{margin:0;color:var(--muted);font-size:1.04rem;line-height:1.7}
.capability-grid,.architecture-grid,.proof-grid,.launch-grid{display:grid;gap:18px}.capability-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.capability-card{display:block;padding:20px 18px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg, rgba(17,24,35,.8), rgba(12,17,25,.92));text-decoration:none;color:var(--text);transition:border-color .2s ease, transform .2s ease}.capability-card:hover{border-color:rgba(115,213,255,.6);transform:translateY(-1px)}.capability-card span{display:block;font-weight:700;margin-bottom:10px}.capability-card p{margin:0;color:var(--muted);line-height:1.6}.architecture-grid,.proof-grid,.launch-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.architecture-grid article,.proof-grid article,.launch-grid article{padding:20px;border:1px solid var(--line);border-radius:14px;background:rgba(17,24,35,.75)}.architecture-grid article h3,.proof-grid article h3,.launch-grid article h3{margin:12px 0 8px;font-size:1.2rem}.architecture-grid article p,.proof-grid article p,.launch-grid article p{margin:0;color:var(--muted);line-height:1.7}.cta{display:flex;align-items:center;justify-content:space-between;gap:24px;padding:30px 24px;border:1px solid var(--line);border-radius:16px;background:linear-gradient(180deg, rgba(13,18,26,.9), rgba(12,17,25,.85));margin-top:var(--section-gap)}.cta h2{margin:10px 0 8px;font-size:clamp(2rem,5vw,3rem);letter-spacing:-.05em}.cta p{margin:0;color:var(--muted);line-height:1.7}.cta-actions{display:flex;flex-wrap:wrap;gap:12px}.@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(110,231,183,.45)}70%{box-shadow:0 0 0 12px rgba(110,231,183,0)}100%{box-shadow:0 0 0 0 rgba(110,231,183,0)}}
@media(max-width:1000px){.explainer-grid,.audience-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.capability-grid,.architecture-grid,.proof-grid,.launch-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.cta{flex-direction:column;align-items:flex-start}}@media(max-width:700px){.hero{padding-top:78px}.section{padding-top:88px}.explainer-grid,.audience-grid{grid-template-columns:1fr}.capability-grid,.architecture-grid,.proof-grid,.launch-grid{grid-template-columns:1fr}.cta-actions,.actions{flex-direction:column;align-items:stretch}.button{width:100%}.cta{padding:22px 18px}}@media(max-width:430px){h1{font-size:clamp(2.55rem,14vw,3.5rem)}.container{width:calc(100% - 24px)}.section-heading h2,.cta h2{font-size:2rem}}
</style>
